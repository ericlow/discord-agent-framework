# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Discord application (Developer Portal)
DISCORD_PUBLIC_KEY=...
DISCORD_APPLICATION_ID=...
DISCORD_BOT_TOKEN=...
DISCORD_GUILD_ID=            # optional: register commands to one server (instant)

# Built-in web tools (search_web / fetch_url)
JINA_API_KEY=...

# Postgres (conversation persistence)
DATABASE_URL=postgresql://postgres:password@localhost:5432/discord_agent

# Set automatically in Lambda; needed for engine-mode self-invocation
# AWS_LAMBDA_FUNCTION_NAME=your-function-name
# AWS_REGION=us-east-1
